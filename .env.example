# Copy to .env and fill in. `.env` is gitignored -- never commit a real token.

# ----------------------------------------------------------------- required
# From @BotFather.
BOT_TOKEN=

# From https://my.telegram.org/apps. These identify the self-hosted Bot API *server*, not your bot.
# Only needed when USE_LOCAL_BOT_API=true.
TELEGRAM_API_ID=1
TELEGRAM_API_HASH=1

# ----------------------------------------------------------------- telegram
# true  -> talk to the telegram-bot-api container; files up to 2 GB.
# false -> talk to api.telegram.org; MAX_FILE_SIZE_MB is force-clamped to 20.
#
# Switching an existing bot from the cloud API to a local server requires calling logOut once:
#   curl https://api.telegram.org/bot<TOKEN>/logOut
USE_LOCAL_BOT_API=false
LOCAL_BOT_API_URL=http://telegram-bot-api:8081
LOCAL_BOT_API_DATA_DIR=/var/lib/telegram-bot-api

# ----------------------------------------------------------------- infrastructure
DATA_DIR=/data
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
WORKER_CONCURRENCY=2

# ----------------------------------------------------------------- limits
MAX_FILE_SIZE_MB=2000
MAX_PAGES=3000
MAX_MERGE_FILES=20
MAX_CONCURRENT_JOBS_PER_USER=1
TASK_SOFT_TIME_LIMIT=1500
TASK_TIME_LIMIT=1800
WORKSPACE_TTL_SECONDS=21600

# ----------------------------------------------------------------- progress
# Telegram allows roughly one message edit per second per chat; 2s is a safe floor.
PROGRESS_MIN_INTERVAL=2.0
PROGRESS_MIN_RATIO=0.05
# ocrmypdf has no per-page callback, so OCR runs in chunks of this many pages to report progress.
OCR_CHUNK_PAGES=10

# ----------------------------------------------------------------- logging
LOG_LEVEL=INFO
LOG_JSON=true
